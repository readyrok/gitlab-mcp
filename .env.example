# Copy this to `.env` and fill in real values. .env is gitignored.

# GitLab.com unless you're using a self-hosted instance.
GITLAB_URL=https://gitlab.com

# Personal Access Token. For seeding you need `api` scope (writes).
# Create at: https://gitlab.com/-/user_settings/personal_access_tokens
# Note: the MCP server itself will use a SEPARATE token with only `read_api`.
GITLAB_TOKEN=glpat-replace-me
